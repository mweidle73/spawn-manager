with "anet";

project Spawn_Common is

   for Source_Dirs use ();
   Source_Dirs := ("src");

   Adaflags := External_As_List ("ADAFLAGS", " ");

   Compiler_Switches := ("-gnatygAdISuxo",
                         "-gnatVa",
                         "-gnatf",
                         "-fstack-check",
                         "-gnato",
                         "-g") & Adaflags;

   C_Compiler_Switches := ("-std=c11",
                           "-W",
                           "-Wall",
                           "-Werror",
                           "-O3");

   Binder_Switches   := ("-E");

end Spawn_Common;
